	<skos:prefLabel xml:lang="fr">École défavorisée</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Escuela desfavorecida</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Отстающие школы</skos:prefLabel>
