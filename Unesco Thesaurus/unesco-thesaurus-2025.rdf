	<skos:prefLabel xml:lang="es">Indicadores ambientales</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Показатели состояния окружающей среды</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">مؤشرات بيئية</skos:prefLabel>
