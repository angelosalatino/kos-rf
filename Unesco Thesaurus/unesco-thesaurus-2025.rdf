<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept1051">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:59:39Z</dct:modified>
	<skos:altLabel xml:lang="es">Eficacia del profesor</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9195"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
