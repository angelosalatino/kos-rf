	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-12T10:57:43Z</dct:modified>
	<skos:altLabel xml:lang="ar">تطبيع اجتماعي</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept395"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Socialization</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Socialisation</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Socialización</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Социализация</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تنشئة اجتماعية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1194"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1462"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5055"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept12671"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept12679"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17154"/>
	<skos:scopeNote xml:lang="en">Process through which individuals internalize the values, beliefs and norms of a society and learn to function as its members.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Processus par lequel l'individu apprend et intériorise les valeurs, les croyances et les normes de la société et par là parvient a son intégration.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Proceso por el que el individuo interioriza los valores, las creencias y las normas de la sociedad y aprende a funcionar como miembro.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Процесс, в рамках которого члены общества усваивают общественные ценности, убеждения и нормы и учатся работать сообща.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">هي عملية يكتسب فيها الفرد قيم المجتمع ومعتقداته وقواعده ويتعلم في نطاقها كيف يصبح عضوا فيه.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept11996">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:31:11Z</dct:modified>
	<skos:altLabel xml:lang="ar">حضرنة</skos:altLabel>
	<skos:altLabel xml:lang="ar">توسع حضري</skos:altLabel>
	<skos:altLabel xml:lang="ar">تمدن</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2148"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Urbanization</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Urbanisation</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Urbanización</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Урбанизация</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تحضر</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept447"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept4008"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3115"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept12784"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3574"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept16538"/>
	<skos:scopeNote xml:lang="en">Population concentration in urban areas as a result of rural migration or due to an increase in the number of urban areas. Do not confuse with "urban development".</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Concentration de population en région urbaine, résultant de l'exode rural ou de l'accroissement du nombre de régions urbaines. Ne pas confondre avec "développement urbain".</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Concentración de población en una región urbana como resultado del éxodo rural o del aumento del número de regiones urbanas. No confundir con "desarrollo urbano".</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Концентрация населения в городских районах в результате миграции сельского населения или в связи с расширением числа городских районов. Не путать с термином "Городское развитие".</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">تَركُز السكان في المناطق الحضرية كنتيجة للهجرة من الريف أو بسبب زيادة عدد المناطق الحضرية. يُرجى عدم الخلط مع مصطلح "التنمية الحضرية".</skos:scopeNote>
</skos:Concept>
