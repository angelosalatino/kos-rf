	<skos:altLabel xml:lang="ru">Классификация должностей</skos:altLabel>
	<skos:altLabel xml:lang="ru">Присвоение должностного разряда</skos:altLabel>
	<skos:altLabel xml:lang="ar">تصنيف الوظائف</skos:altLabel>
	<skos:altLabel xml:lang="ar">تصنيف وظيفي</skos:altLabel>
