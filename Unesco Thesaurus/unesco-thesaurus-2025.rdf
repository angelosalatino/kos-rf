	<skos:prefLabel xml:lang="fr">Haoussa</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Hawsa</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Язык хауса</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">لغة الهوسا</skos:prefLabel>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept16380">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:14:47Z</dct:modified>
