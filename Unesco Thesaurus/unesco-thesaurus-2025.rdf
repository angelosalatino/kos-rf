	<skos:prefLabel xml:lang="es">Biomasa</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Биомасса</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">كتلة حيوية</skos:prefLabel>
