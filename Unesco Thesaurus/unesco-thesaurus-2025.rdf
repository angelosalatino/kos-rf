<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept7019">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T12:19:14Z</dct:modified>
	<skos:altLabel xml:lang="ar">عدم المساواة ثقافيا</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept259"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Cultural inequality</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Inégalité culturelle</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Desigualdad cultural</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Культурное неравенство</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">فوارق ثقافية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6967"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7017"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7018"/>
	<skos:scopeNote xml:lang="en">Disparity of levels of culture and access to it within a given society.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Disparité des niveaux de culture et inégalité des chances d'y accéder dans une société donnée.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Disparidad en los niveles de cultura y de acceso a la misma en una sociedad determinada.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Разные уровни развития культуры и доступа к ней в рамках одного общества.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">التباين في مستويات الثقافة والوصول إليها في مجتمع معين.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept702">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:13:53Z</dct:modified>
	<skos:altLabel xml:lang="en">Democratic Republic of the Congo</skos:altLabel>
	<skos:altLabel xml:lang="fr">République démocratique du Congo</skos:altLabel>
	<skos:altLabel xml:lang="es">República Democrática del Congo</skos:altLabel>
	<skos:altLabel xml:lang="ru">Демократическая Республика Конго</skos:altLabel>
	<skos:altLabel xml:lang="ar">جمهورية الكونجو الديمقراطية</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept697"/>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1616"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Congo DR</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Congo RD</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Congo RD</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">ДР Конго</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">جمهورية الكونغو الديمقراطية</skos:prefLabel>
	<skos:scopeNote xml:lang="en">Use for events after May 1997, otherwise, use Zaire.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">S'applique aux événements survenus après mai 1997, utiliser autrement Zaïre.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Se aplica a los eventos posteriores a mayo de 1997. Para eventos anteriores a tal fecha emplear "Zaire".</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Используется по отношению к событиям, происходившим после мая 1997 г.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">в иных случаях - Заир.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">استخدم للأحداث التي وقعت بعد مايو ۱۹۹۷، فيما عدا ذلك، استخدم زائير.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept7021">
