	<skos:prefLabel xml:lang="en">Centralization</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Centralisation</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Centralización</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Централизация</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">مركزية</skos:prefLabel>
	<skos:related>
		<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept4877">
			<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:23:52Z</dct:modified>
			<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7574"/>
			<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
			<skos:prefLabel xml:lang="en">Decentralization</skos:prefLabel>
			<skos:prefLabel xml:lang="fr">Décentralisation</skos:prefLabel>
			<skos:prefLabel xml:lang="es">Descentralización</skos:prefLabel>
			<skos:prefLabel xml:lang="ru">Децентрализация</skos:prefLabel>
			<skos:prefLabel xml:lang="ar">لامركزية</skos:prefLabel>
			<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1406"/>
			<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept4874"/>
			<skos:scopeNote xml:lang="en">Dispersion or distribution of functions and powers from a central authority to a local authority or community.</skos:scopeNote>
			<skos:scopeNote xml:lang="fr">Déconcentration ou distribution des fonctions et pouvoirs d'une autorité centrale à une autorité locale ou à une communauté.</skos:scopeNote>
			<skos:scopeNote xml:lang="es">Dispersión o distribución de funciones y poderes de una autoridad central a una autoridad local o una comunidad.</skos:scopeNote>
			<skos:scopeNote xml:lang="ru">Передача или распределение функций и полномочий от центрального властного органа к местному ведомству или сообществу.</skos:scopeNote>
			<skos:scopeNote xml:lang="ar">تشتت أو توزيع الوظائف والصلاحيات من سلطة مركزية إلى سلطة محلية أو مجتمعية.</skos:scopeNote>
		</skos:Concept>
	</skos:related>
</skos:Concept>
