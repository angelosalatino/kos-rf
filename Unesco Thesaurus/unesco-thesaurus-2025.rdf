	<skos:altLabel xml:lang="en">Information competency</skos:altLabel>
	<skos:altLabel xml:lang="en">Information fluency</skos:altLabel>
	<skos:altLabel xml:lang="fr">Culture de l'information</skos:altLabel>
	<skos:altLabel xml:lang="fr">Culture informationnelle</skos:altLabel>
	<skos:altLabel xml:lang="fr">Compétence informationnelle</skos:altLabel>
	<skos:altLabel xml:lang="fr">Education à l'information</skos:altLabel>
	<skos:altLabel xml:lang="ar">وعي معلوماتي</skos:altLabel>
	<skos:altLabel xml:lang="ar">كفاءة معلوماتية</skos:altLabel>
	<skos:altLabel xml:lang="ar">طلاقة معلوماتية</skos:altLabel>
	<skos:altLabel xml:lang="ar">دراية معلوماتية</skos:altLabel>
