	<skos:altLabel xml:lang="en">Sustainable economy</skos:altLabel>
	<skos:altLabel xml:lang="es">Economía ecológica</skos:altLabel>
	<skos:altLabel xml:lang="ar">نمو مراعي للبيئة</skos:altLabel>
	<skos:altLabel xml:lang="ar">نمو اخضر</skos:altLabel>
