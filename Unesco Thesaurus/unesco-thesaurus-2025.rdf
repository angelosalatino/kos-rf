	<skos:scopeNote xml:lang="en">Includes philosophy of nature, philosophy of life, infinity, etc.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Inclue la philosophie de la nature, la philosophie de la vie, l'infini, etc.</skos:scopeNote>
