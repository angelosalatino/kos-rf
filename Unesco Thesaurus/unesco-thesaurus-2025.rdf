			<skos:altLabel xml:lang="ar">سجلات عامة</skos:altLabel>
			<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept492"/>
			<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
