	<skos:altLabel xml:lang="ru">Международные студенты</skos:altLabel>
	<skos:altLabel xml:lang="ru">Транснациональные студенты</skos:altLabel>
	<skos:altLabel xml:lang="ar">طلاب دوليون</skos:altLabel>
	<skos:altLabel xml:lang="ar">طلاب عابرون للحدود</skos:altLabel>
