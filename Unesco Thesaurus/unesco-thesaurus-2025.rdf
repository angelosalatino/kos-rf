	<skos:prefLabel xml:lang="en">Selective dissemination of information</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Diffusion sélective de l'information</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Difusión selectiva de información</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Избирательное распространение информации</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">بث انتقائي للمعلومات</skos:prefLabel>
