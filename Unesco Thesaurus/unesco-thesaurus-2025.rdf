	<skos:prefLabel xml:lang="en">Foreign students</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Étudiant étranger</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Estudiante extranjero</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Иностранные учащиеся</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">طلاب اجانب</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9345"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept10423"/>
	<skos:scopeNote xml:lang="en">Students not native to a particular country.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Etudiant n'étant pas natif du pays dans lequel il étudie.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Estudiantes que no son nativos del país en el que estudian.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Учащиеся, не являющиеся гражданами данной страны.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">الطلاب غير الأصليين لبلد معين.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept10323">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:59:01Z</dct:modified>
	<skos:altLabel xml:lang="ar">جامعيون</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept77"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Undergraduates</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Étudiant non diplômé</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Estudiante no diplomado</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Студенты последнего курса</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">طلاب المرحلة الجامعية الاولى</skos:prefLabel>
	<skos:scopeNote xml:lang="en">Students engaged in studies leading to a first degree, e.g. bachelor's degree.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Étudiant engagé dans des études menant à un grade de premier cycle, p. ex. à un baccalauréat.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Estudiante de nivel inferior al primer grado, por ejemplo, de bachillerato.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Учащиеся, которым в конце обучения будет присвоена первая научная степень - степень бакалавра.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">الطلاب الذين سيتم منحهم الدرجة العلمية الأولى في نهاية تعليمهم، على سبيل المثال درجة البكالوريوس.</skos:scopeNote>
</skos:Concept>
