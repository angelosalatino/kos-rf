<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept8755">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:33:45Z</dct:modified>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2234"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Macroeconomics</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Macroéconomie</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Macroeconomía</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Макроэкономика</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">اقتصاد كلي</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept588"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8726"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept13608"/>
	<skos:scopeNote xml:lang="en">An economic study devoted to examining the function of a country's or region's economy or the international economy as a whole.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Étude économique consacrée à l'examen de la fonction de l'économie d'un pays ou d'une région ou de l'économie internationale dans son ensemble.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Estudio económico consagrado al examen de la función de la economía de un país o de una región, o de la economía internacional en su conjunto.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Исследование функционирования экономики отдельной страны, региона или всего мира в качестве единого целого.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">دراسة اقتصادية تنصب على دراسة وظيفة اقتصاد الدولة أو اقتصاد المنطقة أو الاقتصاد الدولي ككل.</skos:scopeNote>
</skos:Concept>
