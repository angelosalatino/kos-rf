<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept12902">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:36:20Z</dct:modified>
	<skos:altLabel xml:lang="es">Investigación marina</skos:altLabel>
	<skos:altLabel xml:lang="es">Investigación marítima</skos:altLabel>
	<skos:altLabel xml:lang="ar">بحوث اوقيانوجرافية</skos:altLabel>
	<skos:altLabel xml:lang="ar">بحث اقيانوجرافي</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept175"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3661"/>
