	<skos:prefLabel xml:lang="ru">Образование в рамках местного сообщества</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تعليم مجتمعي</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept439"/>
