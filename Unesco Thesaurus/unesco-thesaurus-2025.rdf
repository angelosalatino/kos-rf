	<skos:altLabel xml:lang="ar">مراكز الموارد التعليمية</skos:altLabel>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3352"/>
