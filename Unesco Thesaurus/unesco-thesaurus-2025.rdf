	<skos:altLabel xml:lang="ru">Местные знания</skos:altLabel>
	<skos:altLabel xml:lang="ar">معارف الشعوب الاصلية</skos:altLabel>
	<skos:altLabel xml:lang="ar">معارف السكان الاصليين</skos:altLabel>
