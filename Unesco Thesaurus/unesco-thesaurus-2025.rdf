	<skos:prefLabel xml:lang="fr">Gestion de dossiers</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Gestión de documentos</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Управление записями</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">ادارة السجلات</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept492"/>
