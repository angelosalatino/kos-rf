<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept558">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-17T16:38:30Z</dct:modified>
	<skos:altLabel xml:lang="en">Abuse of human rights</skos:altLabel>
	<skos:altLabel xml:lang="fr">Abus des droits de l'homme</skos:altLabel>
	<skos:altLabel xml:lang="fr">Exercice abusif des droits de l'homme</skos:altLabel>
	<skos:altLabel xml:lang="fr">Violation des droits de la personne</skos:altLabel>
	<skos:altLabel xml:lang="fr">Violation des droits humains</skos:altLabel>
	<skos:altLabel xml:lang="es">Abuso de los derechos humanos</skos:altLabel>
	<skos:altLabel xml:lang="es">Ejercicio abusivo de los derechos humanos</skos:altLabel>
	<skos:altLabel xml:lang="es">Violación de los derechos de la persona</skos:altLabel>
