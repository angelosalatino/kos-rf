	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9267"/>
	<skos:prefLabel xml:lang="en">Educational innovations</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Innovation éducative</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Innovación educacional</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Инновации в образовании</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">ابتكارات تربوية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept14"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7273"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7282"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9176"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17170"/>
	<skos:scopeNote xml:lang="en">Changes in objectives, content or methods initiated, as a rule, in experimental situations.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Changement d'objectifs, de contenus ou de méthodes, initié, en règle générale, en situation expérimentale.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Cambio de objetivos, de contenidos o de métodos iniciado, por regla general, en situación experimental.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Изменения в задачах, содержании или методах, инициируемые, как правило, в рамках экспериментов.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">التغيير في الأهداف أو المحتوى أو الأساليب التي بدأت، كقاعدة، في الأوضاع التجريبية.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept7282">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:28:10Z</dct:modified>
	<skos:altLabel xml:lang="en">Educational change</skos:altLabel>
	<skos:altLabel xml:lang="en">Educational renewal</skos:altLabel>
	<skos:altLabel xml:lang="fr">Changement en éducation</skos:altLabel>
	<skos:altLabel xml:lang="fr">Renouveau de l'éducation</skos:altLabel>
	<skos:altLabel xml:lang="fr">Renouveau éducatif</skos:altLabel>
	<skos:altLabel xml:lang="es">Reforma educacional</skos:altLabel>
	<skos:altLabel xml:lang="es">Reforma educativa</skos:altLabel>
	<skos:altLabel xml:lang="ru">Изменения в области образования</skos:altLabel>
	<skos:altLabel xml:lang="ru">Процесс обновления в области образования</skos:altLabel>
	<skos:altLabel xml:lang="ar">اصلاح التعليم</skos:altLabel>
	<skos:altLabel xml:lang="ar">تجديد تربوي</skos:altLabel>
	<skos:altLabel xml:lang="ar">تغيير تربوي</skos:altLabel>
