	<skos:prefLabel xml:lang="ru">Контроль качества</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">مراقبة الجودة</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2567"/>
