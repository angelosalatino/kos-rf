	<skos:altLabel xml:lang="fr">Éducation pour demain</skos:altLabel>
	<skos:altLabel xml:lang="es">Educación del mañana</skos:altLabel>
	<skos:altLabel xml:lang="ru">Перспективы в сфере образования</skos:altLabel>
