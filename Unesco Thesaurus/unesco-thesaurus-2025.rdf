	<skos:altLabel xml:lang="ru">Общество, основанное на знаниях</skos:altLabel>
	<skos:altLabel xml:lang="ru">Общество знаний</skos:altLabel>
	<skos:altLabel xml:lang="ar">مجتمع المعرفة</skos:altLabel>
	<skos:altLabel xml:lang="ar">مجتمع التعلم</skos:altLabel>
	<skos:altLabel xml:lang="ar">عصر المعلومات</skos:altLabel>
