	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7438"/>
	<skos:prefLabel xml:lang="en">Oceanographic research</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Recherche océanographique</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Investigación oceanográfica</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Океанографические исследования</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">ابحاث علم المحيطات</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept10122"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept4447"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept10255"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept13099"/>
	<skos:scopeNote xml:lang="en">Use for works dealing with research projects. For general scientific works, use "oceanography".</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Utiliser pour les ouvrages se rapportant à des projets de recherche. Pour les ouvrages scientifiques généraux, employer "océanographie".</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Se refiere a los trabajos relacionados con proyectos de investigación. Para trabajos científicos generales emplear "oceanografía".</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Используется по отношению к работам в рамках научно-исследовательских проектов. Для работ общего научного характера используйте термин "Океанография".</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">استخدم للأعمال التي تتناول مشروعات البحث. للأعمال العلمية العامة، استخدم "علم المحيطات".</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept12906">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:59:25Z</dct:modified>
	<skos:altLabel xml:lang="en">Participatory approach</skos:altLabel>
	<skos:altLabel xml:lang="fr">Approche participative</skos:altLabel>
	<skos:altLabel xml:lang="es">Aproximación participativa</skos:altLabel>
	<skos:altLabel xml:lang="ru">Консенсусный подход</skos:altLabel>
	<skos:altLabel xml:lang="ar">بحوث قائمة على المشاركة</skos:altLabel>
	<skos:altLabel xml:lang="ar">نهج تشاركي</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept378"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Participatory research</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Recherche participative</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Investigación participativa</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Консенсусные исследования</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">بحث تشاركي</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5339"/>
	<skos:scopeNote xml:lang="en">Research approach that calls for interaction between the researchers and those among whom the research is conducted.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Recherche faisant appel à l'interaction entre les chercheurs et les personnes auprès desquelles la recherche est menée.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Investigación encaminada a la interacción entre los investigadores y entre las personas sobre las cuales está siendo efectuada la investigación.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Исследовательский подход, требующий взаимодействия и сотрудничества между исследователями и исследуемыми объектами.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">نهج بحثي يدعو إلى التفاعل بين الباحثين وأولئك الذين تُجرى عليهم الأبحاث.</skos:scopeNote>
</skos:Concept>
