	<skos:prefLabel xml:lang="en">Regional cooperation</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Coopération régionale</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Cooperación regional</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Региональное сотрудничество</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تعاون اقليمي</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5701"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8769"/>
