	<skos:prefLabel xml:lang="en">Dependence</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Dépendance économique</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Dependencia</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Зависимость</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تبعية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5616"/>
