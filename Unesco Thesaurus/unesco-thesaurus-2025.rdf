	<skos:altLabel xml:lang="ru">Постановка целей</skos:altLabel>
	<skos:altLabel xml:lang="ar">تحديد الاهداف</skos:altLabel>
	<skos:altLabel xml:lang="ar">وضع الاهداف</skos:altLabel>
	<skos:altLabel xml:lang="ar">ادارة بحسب الاهداف</skos:altLabel>
	<skos:altLabel xml:lang="ar">ادارة استهدافية</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept672"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Management by objectives</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Direction par objectifs</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Dirección a través de objetivos</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Управление посредством постановки задач</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">ادارة بالاهداف</skos:prefLabel>
	<skos:scopeNote xml:lang="en">Setting targets within an organization in order to achieve greater efficiency.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Détermination de buts à atteindre dans une organisation afin de réaliser un meilleur rendement.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Definición de los objetivos a alcanzar en una organización con el fin de alcanzar un mayor rendimiento.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Постановка задач в рамках деятельности организации в целях достижения большей эффективности.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">تحديد الأهداف للمؤسسة من أجل تحقيق كفاءة أكبر.</skos:scopeNote>
</skos:Concept>
