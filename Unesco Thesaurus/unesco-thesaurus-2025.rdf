	<skos:prefLabel xml:lang="en">Gender-based violence</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Violence fondée sur le genre</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Violencia de género</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">гендерное насилие</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">عنف جنساني</skos:prefLabel>
