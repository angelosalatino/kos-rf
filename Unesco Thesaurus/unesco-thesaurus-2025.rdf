	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:35:37Z</dct:modified>
	<skos:altLabel xml:lang="es">Clases al aire libre</skos:altLabel>
	<skos:altLabel xml:lang="ar">تربية خلوية</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept39"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Outdoor education</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Enseignement en plein air</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Enseñanza al aire libre</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Уроки на открытом воздухе</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تعليم في الهواء الطلق</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1491"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1282"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8692"/>
	<skos:scopeNote xml:lang="en">Utilization of the outdoor environment to promote experiential learning and enrich the curriculum.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Utilisation de l'environnement extérieur pour promouvoir l'apprentissage par l'expérience et enrichir le programme d'études.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Utilización del entorno exterior para promover el aprendizaje a través de la experiencia y enriquecer el programa de estudios.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Использование возможностей среды вне помещений для развития эмпирического обучения и пополнения учебного плана.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">استخدام البيئة الخارجية لتعزيز التعلم التجريبي وإثراء المناهج الدراسية.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept989">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-24T11:22:01Z</dct:modified>
	<skos:altLabel xml:lang="fr">Acronyme</skos:altLabel>
	<skos:altLabel xml:lang="ar">اسماء مختصرة</skos:altLabel>
	<skos:altLabel xml:lang="ar">تسميات استهلالية</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept988"/>
