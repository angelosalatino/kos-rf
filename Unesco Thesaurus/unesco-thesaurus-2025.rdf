<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept10338">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:50:51Z</dct:modified>
