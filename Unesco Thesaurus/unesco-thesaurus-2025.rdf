<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept5570">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:26:28Z</dct:modified>
	<skos:altLabel xml:lang="en">Labour conditions</skos:altLabel>
	<skos:altLabel xml:lang="es">Condiciones laborales</skos:altLabel>
	<skos:altLabel xml:lang="ru">Условия труда</skos:altLabel>
	<skos:altLabel xml:lang="ar">احوال العمل</skos:altLabel>
	<skos:altLabel xml:lang="ar">اوضاع العمل</skos:altLabel>
	<skos:altLabel xml:lang="ar">شروط العمل</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5567"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1169"/>
