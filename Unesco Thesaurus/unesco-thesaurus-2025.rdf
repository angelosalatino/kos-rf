<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept7876">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:34:17Z</dct:modified>
	<skos:altLabel xml:lang="ar">استراتيجيات إنمائية</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1800"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2599"/>
