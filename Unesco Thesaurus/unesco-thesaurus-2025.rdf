<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept17017">
	<dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2004-04-23T00:00:00</dct:created>
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-08-08T12:07:47Z</dct:modified>
	<skos:altLabel xml:lang="en">Education for communication</skos:altLabel>
	<skos:altLabel xml:lang="en">Media literacy</skos:altLabel>
	<skos:altLabel xml:lang="ru">Образование в области передачи информации и связи</skos:altLabel>
	<skos:altLabel xml:lang="ru">Грамотность в области средств массовой информации</skos:altLabel>
	<skos:altLabel xml:lang="ar">تثقيف اعلامي</skos:altLabel>
	<skos:altLabel xml:lang="ar">تعليم في مجال الاتصالات</skos:altLabel>
	<skos:altLabel xml:lang="ar">محو الامية الاعلامية</skos:altLabel>
	<skos:altLabel xml:lang="ar">تثقيف في مجال وسائل الاعلام</skos:altLabel>
	<skos:altLabel xml:lang="es">Alfabetización mediática</skos:altLabel>
	<skos:altLabel xml:lang="es">Educación mediática</skos:altLabel>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Media education</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Éducation aux médias</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Educación sobre medios de comunicación</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Образование в области деятельности средств массовой информации</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تربية اعلامية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept482"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept487"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17077"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1546"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3321"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5761"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17116"/>
	<skos:scopeNote xml:lang="en">Seeks to enable people to gain an understanding of the way the media act and operate in society, and critically analyze media messages.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Enseignement du rôle et fonctionnement des médias dans la société, y compris l'analyse critique du contenu des messages véhiculés.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Educación encaminada a hacer comprender cómo actúan y cómo operan los medios de comunicación en la sociedad y a enseñar a analizar sus mensajes críticamente .</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Ориентировано на то, чтобы объяснить слушателям, как работают средства массовой информации в обществе и научить критически анализировать содержание СМИ.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">يهدف إلى جعل الناس قادرين على فهم طريقة العمل الإعلامي في المجتمع وكيفية تحليل رسائله بشكل نقدي.</skos:scopeNote>
	<skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
</skos:Concept>
