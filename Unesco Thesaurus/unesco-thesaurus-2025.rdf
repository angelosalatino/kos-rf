	<skos:prefLabel xml:lang="en">Green economy</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Economie verte</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Economía verde</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">اقتصاد اخضر</skos:prefLabel>
