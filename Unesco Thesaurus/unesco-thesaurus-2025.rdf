<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept587">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-21T23:41:24Z</dct:modified>
	<skos:altLabel xml:lang="en">Economic interdependence</skos:altLabel>
	<skos:altLabel xml:lang="fr">Interdépendance économique</skos:altLabel>
	<skos:altLabel xml:lang="es">Interdependencia económica</skos:altLabel>
	<skos:altLabel xml:lang="ru">Экономическая взаимозависимость</skos:altLabel>
	<skos:altLabel xml:lang="ar">تكافل</skos:altLabel>
	<skos:altLabel xml:lang="ar">اعتماد اقتصادي متبادل</skos:altLabel>
	<skos:altLabel xml:lang="ar">ترابط اقتصادي</skos:altLabel>
	<skos:altLabel xml:lang="ar">تكافل اقتصادي</skos:altLabel>
	<skos:altLabel xml:lang="ar">ترابط</skos:altLabel>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3929"/>
	<skos:prefLabel xml:lang="en">Interdependence</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Interdépendance</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Interdependencia</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Взаимозависимость</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">اعتماد متبادل</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3533"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8769"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6576"/>
	<skos:scopeNote xml:lang="en">Mutual economic dependence among countries. For active efforts to promote closer economic ties, use "economic cooperation", "economic integration", etc.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Dépendance économique mutuelle entre pays. Pour signifier les efforts déployés pour promouvoir un resserrement des liens économiques, utiliser "coopération économique", "intégration économique", etc.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Mutua dependencia económica entre países. Para referirse a los esfuerzos desplegados para estrechar las relaciones económicas, utilizar "cooperación económica", "integración económica", etc.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Взаимная экономическая зависимость между странами</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">по отношению к активным действиям в целях более тесных экономических взаимосвязей используйте термины "Экономическое сотрудничество", "Экономическая интеграция" и т.д.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">الاعتماد الاقتصادي المتبادل بين الدول. وللجهود الحثيثة الرامية إلى تعزيز الروابط الاقتصادية، استخدم "التعاون الاقتصادي"، "التكامل الاقتصادي"، وما إلى ذلك.</skos:scopeNote>
	<skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept5872">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:35:46Z</dct:modified>
	<skos:altLabel xml:lang="en">Community colleges</skos:altLabel>
	<skos:altLabel xml:lang="fr">Collège communautaire</skos:altLabel>
	<skos:altLabel xml:lang="ru">Колледжи местного сообщества</skos:altLabel>
	<skos:altLabel xml:lang="ar">كليات مجتمعية</skos:altLabel>
	<skos:altLabel xml:lang="ar">مدارس محلية</skos:altLabel>
	<skos:altLabel xml:lang="ar">كليات محلية</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept46"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Community schools</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">École communautaire</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Escuela comunitaria</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Учебные заведения для местного сообщества</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">مدارس مجتمعية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1482"/>
	<skos:scopeNote xml:lang="en">Schools open beyond ordinary hours for use of students, their parents and the community.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Ecole ouverte au-delà des horaires habituels, à l'usage des élèves, de leurs parents et de la communauté.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Escuela abierta más de las horas habituales para los estudiantes, sus padres y la comunidad.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Учебные заведения, открытые после уроков для учащихся, их родителей и местного сообщества.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">مدارس مفتوحة خارج الساعات العادية للطلاب وأولياء أمورهم والمجتمع.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept5873">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-17T16:38:27Z</dct:modified>
	<skos:altLabel xml:lang="es">Educación de masas</skos:altLabel>
	<skos:altLabel xml:lang="ar">تثقيف جماهيري</skos:altLabel>
	<skos:altLabel xml:lang="ar">تعليم جماعي</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept37"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Mass education</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Éducation de masse</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Educación masiva</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Массовое образование</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تعليم جماهيري</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept512"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1482"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1546"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1548"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6465"/>
	<skos:scopeNote xml:lang="en">A large-scale undertaking aimed at disseminating information to influence the opinion of the general public. May also be used in relation to the propagation of popular culture.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Opération d'envergure visant la dissémination d'information pour influencer l'opinion publique générale. Peut s'utiliser aussi dans le contexte de la diffusion de la culture populaire.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Operación de envergadura encaminada a la diseminación de información para influenciar a la opinión pública general. También puede ser utilizado en el contexto de la propagación de la cultura popular.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Крупномасштабное мероприятие, направленное на распространение информации в целях воздействия на мнение большинства населения</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">также может использоваться в связи с распространением популярной культуры.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">تعهد واسع النطاق يهدف إلى نشر المعلومات للتأثير على رأي الجمهور العام. يمكن أن تستخدم أيضًا فيما يتعلق بنشر الثقافة الشعبية.</skos:scopeNote>
</skos:Concept>
