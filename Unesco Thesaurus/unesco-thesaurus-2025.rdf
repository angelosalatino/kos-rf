	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Green chemistry</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chimie verte</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Química verde</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">«зеленая» химия</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">الكيمياء الخضراء</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7775"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6317"/>
	<skos:scopeNote xml:lang="en">Design of products and processes that reduce or eliminate the use and generation of hazardous substances.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">تصميم منتجات وعمليات تقلل من استخدام المواد الخطرة أو توليدها، أو تمنعها تمامًا.</skos:scopeNote>
</skos:Concept>
