<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept3341">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:33:23Z</dct:modified>
	<skos:altLabel xml:lang="ar">افلام ثابتة</skos:altLabel>
	<skos:altLabel xml:lang="ar">شرائط الافلام</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept10826"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Film strips</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Film fixe</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Cinta de película</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Диафильмы</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">اشرطة الافلام</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept508"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3333"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7968"/>
	<skos:scopeNote xml:lang="en">A strip of motion picture carrying a still photograph, or other graphic material, on each of its frames. Widely used as an audiovisual instruction tool.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Bande de film comportant des images photographiques ou autre matériel graphique projetés comme images fixes. Largement utilisé comme support à l'enseignement audiovisuel.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Banda de película donde están las imágenes fotográficas u otro material gráfico proyectadas como imágenes fijas, muy empleado como herramienta de enseñanza de las artes audiovisuales.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Фотолента, на каждом кадре которой изображена фотография или иной графический материал</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">широко используется в качестве аудиовизуального учебного пособия.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">شريط من الصور المتحركة يحمل صورة ثابتة، أو غيرها من المواد المصورة، على كل إطار من إطاراته. يستخدم على نطاق واسع كأداة للتعليم السمعي البصري.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept3342">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:58:32Z</dct:modified>
	<skos:altLabel xml:lang="en">Media assisted education</skos:altLabel>
	<skos:altLabel xml:lang="fr">Éducation par les médias</skos:altLabel>
	<skos:altLabel xml:lang="es">Educación a través de los medios de comunicación</skos:altLabel>
	<skos:altLabel xml:lang="ru">Образование с использованием современных технологий</skos:altLabel>
	<skos:altLabel xml:lang="ar">تعليم بمساعدة الوسائط</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept83"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3339"/>
	<skos:prefLabel xml:lang="en">Multimedia instruction</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Enseignement multimédias</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Enseñanza multimedia</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Мультимедийное обучение</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تعليم متعدد الوسائط</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept96"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept97"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3333"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3334"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3335"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3336"/>
	<skos:scopeNote xml:lang="en">Integration of more than one medium in a presentation or module of instruction.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Intégration d'au moins deux médias dans une présentation ou dans un module de formation.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Integración de al menos dos medios de comunicación en una presentación o en un módulo de formación.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Интеграция одного или нескольких информационных носителей в учебное объяснение или учебный модуль.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">دمج أكثر من وسيط في عرض تقديمي أو وحدة إرشادية.</skos:scopeNote>
</skos:Concept>
