	<skos:prefLabel xml:lang="en">Developmental psychology</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Psychologie du développement</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Psicología del desarrollo</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Эволюционная психология</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">علم نفس النمو</skos:prefLabel>
