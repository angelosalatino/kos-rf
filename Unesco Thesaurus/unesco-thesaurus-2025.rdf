<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept36">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-10-14T12:08:37Z</dct:modified>
	<skos:altLabel xml:lang="ar">مستويات التعليم</skos:altLabel>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1485"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5081"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9290"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9291"/>
	<skos:prefLabel xml:lang="en">Educational levels</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Niveau d'enseignement</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Nivel de enseñanza</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Учебные уровни</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">مستويات تعليمية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept21"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept37"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17130"/>
	<skos:scopeNote xml:lang="en">Broad steps of formal educational progressions. Used as a classification in educational organization and statistics.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Grandes étapes marquant la progression dans un système formel d'éducation. Utilisé comme point de référence dans l'organisation de l'éducation et les statistiques.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Grandes etapas que señalan el progreso en un sistema formal de educación. Emplear como punto de referencia para la organización y las estadísticas educacionales.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Этапы в прохождении обязательного образования, применяемые в классификации образовательных учреждений и статистике.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">الخطوات العامة للتقدم في التعليم الرسمي. تستخدم كتصنيف للتنظيم التربوي والإحصاء.</skos:scopeNote>
	<skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
</skos:Concept>
