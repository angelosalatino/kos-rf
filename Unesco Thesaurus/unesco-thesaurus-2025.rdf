<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept7281">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-03-21T16:32:49Z</dct:modified>
	<skos:altLabel xml:lang="fr">Innovation en éducation</skos:altLabel>
	<skos:altLabel xml:lang="es">Innovación educativa</skos:altLabel>
	<skos:altLabel xml:lang="ar">ابتكارات تعليمية</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
