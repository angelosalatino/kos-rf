	<skos:prefLabel xml:lang="es">Conflicto laboral</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Трудовые споры</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">نزاعات العمل</skos:prefLabel>
