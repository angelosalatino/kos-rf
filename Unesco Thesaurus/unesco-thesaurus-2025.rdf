	<skos:prefLabel xml:lang="es">RFSS de Rusia</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Российская СФСР</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">جمهورية روسيا الاتحادية الاشتراكية السوفيتية</skos:prefLabel>
	<skos:scopeNote xml:lang="en">Use for events between 1917 and 1991.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">S'applique aux événements survenus entre 1917 et 1991.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Se aplica a los eventos del periodo de 1917 hasta 1991.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Используется по отношению к событиям, происходившим в период 1917-1991 гг.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">استخدم للأحداث التي وقعت بين ١٩١٧ و١٩٩١.</skos:scopeNote>
</skos:Concept>
