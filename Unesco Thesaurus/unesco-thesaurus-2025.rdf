	<skos:prefLabel xml:lang="es">Cultura científica</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Научная культура</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">ثقافة علمية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3974"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8279"/>
	<skos:scopeNote xml:lang="en">Pattern of intellectual and social behaviour based on scientific knowledge.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Modèle de comportement intellectuel et social basé sur la connaissance scientifique.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Modelo de comportamiento intelectual y social basado en el conocimiento científico.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Модели интеллектуального и социального поведения, основанные на научных знаниях.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">نمط السلوك الفكري والاجتماعي القائم على المعرفة العلمية.</skos:scopeNote>
</skos:Concept>
