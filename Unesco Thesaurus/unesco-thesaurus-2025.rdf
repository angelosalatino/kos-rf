			<skos:prefLabel xml:lang="en">Economic relations</skos:prefLabel>
			<skos:prefLabel xml:lang="fr">Relations économiques</skos:prefLabel>
			<skos:prefLabel xml:lang="es">Relaciones económicas</skos:prefLabel>
			<skos:prefLabel xml:lang="ru">Экономические отношения</skos:prefLabel>
			<skos:prefLabel xml:lang="ar">علاقات اقتصادية</skos:prefLabel>
			<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3927"/>
			<skos:scopeNote xml:lang="en">Refers only to bilateral relations between countries.</skos:scopeNote>
			<skos:scopeNote xml:lang="fr">Se réfère uniquement aux relations bilatérales entre pays.</skos:scopeNote>
			<skos:scopeNote xml:lang="es">Se refiere solamente a las relaciones bilaterales entre países.</skos:scopeNote>
			<skos:scopeNote xml:lang="ru">Относится только к двусторонним отношениям между странами.</skos:scopeNote>
			<skos:scopeNote xml:lang="ar">يشير فقط إلى العلاقات الثنائية بين الدول.</skos:scopeNote>
		</skos:Concept>
	</skos:related>
</skos:Concept>
