<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept3412">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:59:49Z</dct:modified>
	<skos:altLabel xml:lang="en">Concept analysis</skos:altLabel>
	<skos:altLabel xml:lang="en">Subject indexing</skos:altLabel>
	<skos:altLabel xml:lang="fr">Analyse conceptuelle</skos:altLabel>
