	<skos:prefLabel xml:lang="es">Demografía</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Демография</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">علم دراسة السكان</skos:prefLabel>
