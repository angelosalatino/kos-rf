	<skos:prefLabel xml:lang="es">Patrimonio común universal</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Мировые ресурсы</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">مشاعات عالمية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept199"/>
