	<skos:prefLabel xml:lang="en">Cultural diversity</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Diversité culturelle</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Diversidad cultural</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Культурное разнообразие</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تنوع ثقافي</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept259"/>
