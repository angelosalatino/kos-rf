	<skos:altLabel xml:lang="es">Investigación sobre los usuarios de información</skos:altLabel>
	<skos:altLabel xml:lang="ru">Анализ пользователей (информации)</skos:altLabel>
	<skos:altLabel xml:lang="ar">تحليل المستفيد (المعلومات)</skos:altLabel>
