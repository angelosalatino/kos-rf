	<skos:altLabel xml:lang="ru">Улучшение учебного плана</skos:altLabel>
	<skos:altLabel xml:lang="ru">Инновации в учебном плане</skos:altLabel>
	<skos:altLabel xml:lang="ru">Разработка учебного плана</skos:altLabel>
	<skos:altLabel xml:lang="ru">Реформа учебного плана</skos:altLabel>
	<skos:altLabel xml:lang="ru">Реорганизация учебного плана</skos:altLabel>
	<skos:altLabel xml:lang="ar">تحسين المناهج الدراسية</skos:altLabel>
	<skos:altLabel xml:lang="ar">اعادة تنظيم المناهج الدراسية</skos:altLabel>
	<skos:altLabel xml:lang="ar">اعداد المناهج الدراسية</skos:altLabel>
