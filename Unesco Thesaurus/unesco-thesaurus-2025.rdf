	<skos:altLabel xml:lang="ar">معالجة البيانات عن بُعد</skos:altLabel>
	<skos:altLabel xml:lang="ar">معالجة وكشف الاشارات</skos:altLabel>
	<skos:altLabel xml:lang="ar">معالجة عن بعد</skos:altLabel>
	<skos:altLabel xml:lang="ar">معاملة البيانات</skos:altLabel>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5530"/>
