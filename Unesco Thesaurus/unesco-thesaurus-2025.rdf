	<skos:prefLabel xml:lang="fr">Enseignement bilingue</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Educación bilingüe</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Двуязычное образование</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تعليم ثنائي اللغة</skos:prefLabel>
