	<skos:prefLabel xml:lang="fr">Éducation du consommateur</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Educación del consumidor</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Обучение потребителя</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تثقيف المستهلك</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept58"/>
