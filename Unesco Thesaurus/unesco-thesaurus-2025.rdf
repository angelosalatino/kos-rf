	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Educational reform</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Réforme de l'éducation</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Reforma de la educación</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Реформа образования</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">اصلاح تربوي</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept14"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7273"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7281"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7597"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8260"/>
	<skos:scopeNote xml:lang="en">Change planned or in process of implementation to a major part of a national system of education.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Changement planifié ou en cours d'application d'une partie importante d'un système national d'éducation.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Cambio planificado, o en proceso de aplicación, de una parte determinante de un sistema nacional de educación.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Запланированные или реализуемые изменения в отношении основной части национальной системы образования.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">تغيير مخطط أو قيد التنفيذ في جزء كبير من نظام التعليم الوطني.</skos:scopeNote>
</skos:Concept>
