	<skos:altLabel xml:lang="es">Mancha solar</skos:altLabel>
	<skos:altLabel xml:lang="es">Perturbación solar</skos:altLabel>
	<skos:altLabel xml:lang="ru">Солнечные возмущения</skos:altLabel>
	<skos:altLabel xml:lang="ru">Солнечные пятна</skos:altLabel>
	<skos:altLabel xml:lang="ar">اضطرابات شمسية</skos:altLabel>
	<skos:altLabel xml:lang="ar">بقع شمسية</skos:altLabel>
	<skos:altLabel xml:lang="ar">كُلَف شمسية</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept16562"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Solar activity</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Activité solaire</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Actividad solar</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Солнечная активность</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">نشاط شمسي</skos:prefLabel>
	<skos:scopeNote xml:lang="en">Includes solar wind, flares, prominences, sunspots.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Inclue le vent solaire, les éruptions, les protubérances et les taches solaires.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Incluye el viento solar, las erupciones, las protuberancias y las manchas solares.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Включает солнечный ветер, вспышки, протуберанцы, пятна.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">يتضمن الرياح الشمسية والاندلاعات الشمسية والشواظ، والبقع الشمسية.</skos:scopeNote>
</skos:Concept>
