<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept4227">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:59:00Z</dct:modified>
	<skos:altLabel xml:lang="ar">مونوجرافات</skos:altLabel>
