		<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept2798">
			<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:58:51Z</dct:modified>
			<skos:altLabel xml:lang="en">Public records</skos:altLabel>
