<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept3427">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:28:35Z</dct:modified>
	<skos:altLabel xml:lang="en">Educational self management</skos:altLabel>
	<skos:altLabel xml:lang="en">School based management</skos:altLabel>
	<skos:altLabel xml:lang="fr">Autogestion éducative</skos:altLabel>
	<skos:altLabel xml:lang="es">Autogestión educativa</skos:altLabel>
	<skos:altLabel xml:lang="es">Independencia educativa</skos:altLabel>
	<skos:altLabel xml:lang="ru">Самоуправление в сфере образования</skos:altLabel>
	<skos:altLabel xml:lang="ar">ادارة ذاتية للتعليم</skos:altLabel>
	<skos:altLabel xml:lang="ar">ادارة  مدرسية</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3045"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1071"/>
	<skos:prefLabel xml:lang="en">Educational autonomy</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Autonomie éducative</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Autonomía educativa</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Образовательная автономия</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">استقلال ذاتي تعليمي</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept31"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7501"/>
	<skos:scopeNote xml:lang="en">Arrangements giving educational establishments at any level a degree of autonomy in administrative and programme matters.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Accord donnant aux établissements éducatifs de tous niveaux une certaine autonomie en matière d'administration et de programmes.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Acuerdos que otorgan a establecimientos educativos de todos los niveles un cierto grado de autonomía en materia de administración y de programas.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Условия, предоставляющие учебному заведению любого уровня определенную степень автономии в административных и программных вопросах.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">الشروط التي توفر لمؤسسة تعليمية من أي مستوى درجة معينة من الاستقلالية في الأمور الإدارية والبرنامجية.</skos:scopeNote>
</skos:Concept>
