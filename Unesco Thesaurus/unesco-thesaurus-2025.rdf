<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept7267">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:44:08Z</dct:modified>
	<skos:altLabel xml:lang="en">Integrated education</skos:altLabel>
	<skos:altLabel xml:lang="en">Interdisciplinary curriculum</skos:altLabel>
	<skos:altLabel xml:lang="es">Educación integrada</skos:altLabel>
	<skos:altLabel xml:lang="ru">Интегрированное образование</skos:altLabel>
	<skos:altLabel xml:lang="ru">Междисциплинарный учебный план</skos:altLabel>
	<skos:altLabel xml:lang="ar">مناهج تعليمية متكاملة</skos:altLabel>
	<skos:altLabel xml:lang="ar">تعليم متكامل</skos:altLabel>
	<skos:altLabel xml:lang="ar">منهج متعدد التخصصات</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept49"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Integrated curriculum</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Programme d'études intégré</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Plan de estudios integrado</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Интегрированный учебный план</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">منهج متكامل</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2595"/>
	<skos:scopeNote xml:lang="en">Systematic organization of curriculum content and parts into a meaningful pattern.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Organisation systématique du contenu et des parties d'un curriculum en un modèle rationnel.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Organización sistemática del contenido y de las partes de un plan de estudios en un modelo racional.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Систематизация учебного плана и его отдельных частей.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">التنظيم المنهجي لمحتوى المنهاج وأجزاء منه في نمط ذي معنى.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept7268">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:25:09Z</dct:modified>
	<skos:altLabel xml:lang="en">Modular courses</skos:altLabel>
	<skos:altLabel xml:lang="en">Modular curriculum</skos:altLabel>
	<skos:altLabel xml:lang="en">Modular learning</skos:altLabel>
	<skos:altLabel xml:lang="en">Modular training</skos:altLabel>
	<skos:altLabel xml:lang="fr">Cours modulaire</skos:altLabel>
	<skos:altLabel xml:lang="fr">Formation par modules</skos:altLabel>
	<skos:altLabel xml:lang="fr">Programme modulaire</skos:altLabel>
	<skos:altLabel xml:lang="es">Aprendizaje por módulos</skos:altLabel>
	<skos:altLabel xml:lang="es">Curso por módulos</skos:altLabel>
	<skos:altLabel xml:lang="es">Formación por módulos</skos:altLabel>
	<skos:altLabel xml:lang="ru">Модульные курсы</skos:altLabel>
	<skos:altLabel xml:lang="ru">Модульный учебный план</skos:altLabel>
	<skos:altLabel xml:lang="ru">Модульная учеба</skos:altLabel>
	<skos:altLabel xml:lang="ru">Модульная подготовка</skos:altLabel>
	<skos:altLabel xml:lang="ar">دورات نموذجية</skos:altLabel>
	<skos:altLabel xml:lang="ar">منهج معياري</skos:altLabel>
	<skos:altLabel xml:lang="ar">تعليم مرن</skos:altLabel>
	<skos:altLabel xml:lang="ar">تدريب قياسي</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept49"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Modular instruction</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Enseignement modulaire</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Enseñanza por módulos</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Модульное обучение</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تدريب نموذجي</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept83"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8243"/>
	<skos:scopeNote xml:lang="en">Organization of the curriculum or of instructional courses in self-contained units ('modules') designed for management by the learner.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Organisation du curriculum ou d'un programme d'études en unités autonomes ('modules') pour en faciliter la gestion par l'apprenant.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Organización del programa de estudios en unidades autónomas (módulos) para facilitar la gestión por parte del alumno.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Организация учебного плана или учебного курса в рамках замкнутых ячеек ("модулей"), материал которых предназначен для освоения обучаемым.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">تنظيم المناهج الدراسية أو الدورات التعليمية في إطار وحدات مستقلة ("نماذج") مصممة لتُدار من قبل المتعلم.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept7269">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:29:11Z</dct:modified>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept15"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Instructional programmes</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Programme d'enseignement</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Programa de enseñanza</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Программы обучения</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">برامج تعليمية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept49"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept50"/>
	<skos:scopeNote xml:lang="en">Outline of procedures, courses and subjects to be provided by an educational institution over a given period of time.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Résumé des instructions, cours et matières d'enseignement qui seront dispensés par une institution éducative au cours d'une période de temps définie.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Resumen de las instrucciones, los cursos y las asignaturas que serán impartidas por una institución educativa en un periodo de tiempo determinado.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Описание процедур, курсов и предметов, которые должны быть обеспечены образовательным заведением в течение определенного периода времени.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">ملخص الإرشادات والدورات والمواد التعليمية التي تقدمها مؤسسة تعليمية خلال فترة محددة من الزمن.</skos:scopeNote>
</skos:Concept>
