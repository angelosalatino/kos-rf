			<skos:altLabel xml:lang="en">Black economy</skos:altLabel>
			<skos:altLabel xml:lang="en">Informal economy</skos:altLabel>
			<skos:altLabel xml:lang="en">Unofficial economy</skos:altLabel>
			<skos:altLabel xml:lang="fr">Économie clandestine</skos:altLabel>
