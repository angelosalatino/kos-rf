	<skos:altLabel xml:lang="en">Human resources management</skos:altLabel>
	<skos:altLabel xml:lang="en">Personnel administration</skos:altLabel>
	<skos:altLabel xml:lang="en">Staff management</skos:altLabel>
	<skos:altLabel xml:lang="fr">Administration du personnel</skos:altLabel>
	<skos:altLabel xml:lang="fr">Gestion des ressources humaines</skos:altLabel>
	<skos:altLabel xml:lang="es">Administración del personal</skos:altLabel>
	<skos:altLabel xml:lang="es">Gestión de los recursos humanos</skos:altLabel>
	<skos:altLabel xml:lang="es">Planificación del personal</skos:altLabel>
	<skos:altLabel xml:lang="ru">Руководство персоналом</skos:altLabel>
	<skos:altLabel xml:lang="ru">Управление штатом</skos:altLabel>
	<skos:altLabel xml:lang="ru">Управление людскими ресурсами</skos:altLabel>
	<skos:altLabel xml:lang="ar">ادارة الموارد البشرية</skos:altLabel>
	<skos:altLabel xml:lang="ar">ادارة شئون الموظفين</skos:altLabel>
	<skos:altLabel xml:lang="ar">ادارة شئون الافراد</skos:altLabel>
	<skos:altLabel xml:lang="ar">ادارة الموظفين</skos:altLabel>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5567"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7237"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9494"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2572"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept12216"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6510"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3437"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8565"/>
	<skos:prefLabel xml:lang="en">Personnel management</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Gestion du personnel</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Gestión del personal</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Управление персоналом</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">ادارة شئون العاملين</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7758"/>
	<skos:scopeNote xml:lang="en">Refers to all management decisions affecting the nature of the relationship between the organization and its employees, i.e. its human resources.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Se réfère à toutes les décisions administratives portant sur la nature des relations entre une organisation et ses employés, c.-à-d., ses ressources humaines.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Se refiere a todas las decisiones administrativas sobre la naturaleza de las relaciones entre una organización y sus empleados.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Относится ко всем управленческим решениям, влияющим на взаимоотношения между организацией и работниками, т.е. людскими ресурсами.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">يشير إلى كل القرارات الإدارية التي تؤثر على طبيعة العلاقة بين المنظمة وموظفيها، أي مواردها البشرية.</skos:scopeNote>
	<skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
</skos:Concept>
