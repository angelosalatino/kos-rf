<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept9651">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:26:18Z</dct:modified>
	<skos:altLabel xml:lang="en">Manpower services</skos:altLabel>
	<skos:altLabel xml:lang="en">Placement services</skos:altLabel>
	<skos:altLabel xml:lang="fr">Service de la main-d'oeuvre</skos:altLabel>
	<skos:altLabel xml:lang="fr">Service de placement</skos:altLabel>
	<skos:altLabel xml:lang="es">Servicio de mano de obra</skos:altLabel>
	<skos:altLabel xml:lang="ru">Услуги в области использования рабочей силы</skos:altLabel>
	<skos:altLabel xml:lang="ru">Услуги по трудоустройству</skos:altLabel>
	<skos:altLabel xml:lang="ar">خدمات القوى العاملة</skos:altLabel>
	<skos:altLabel xml:lang="ar">خدمات التعيين</skos:altLabel>
	<skos:altLabel xml:lang="ar">خدمات العمالة</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept682"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Employment services</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Service de l'emploi</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Servicio de empleo</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Услуги в области занятости</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">خدمات التوظيف</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5145"/>
	<skos:scopeNote xml:lang="en">Services provided officially by governments as well as those run on a private fee-paying basis.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Services fournis officiellement par des gouvernements aussi bien que ceux qui sont proposés sur une base privée et payante.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Se refiere a los servicios ofrecidos por los gobiernos y a los servicios privados previo pago.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Услуги, предоставляемые государственными организациями официально либо частными структурами за плату.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">الخدمات التي تقدمها الهيئات العامة أو المؤسسات الخاصة رسميا لقاء رسوم.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept9652">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-21T23:41:15Z</dct:modified>
	<skos:altLabel xml:lang="ar">تشغيل كامل</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept682"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Full employment</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Plein emploi</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Pleno empleo</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Полная занятость</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">عمالة كاملة</skos:prefLabel>
	<skos:scopeNote xml:lang="en">Situation where all persons seeking employment have been provided with paid positions.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Situation selon laquelle toute la main-d'oeuvre disponible a pu bénéficier d'un emploi rémunéré.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Situación en la cual toda la mano de obra disponible se ha podido beneficiar de un empleo remunerado.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Ситуация, в которой все лица, заинтересованные найти работу, обеспечены оплачиваемыми рабочими местами.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">حالة يتم فيها تزويد جميع الأشخاص الراغبين في العثور على وظيفة بوظائف مدفوعة الأجر.</skos:scopeNote>
</skos:Concept>
