	<skos:prefLabel xml:lang="fr">Éducation des adultes</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Educación de adultos</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Образование для взрослого населения</skos:prefLabel>
