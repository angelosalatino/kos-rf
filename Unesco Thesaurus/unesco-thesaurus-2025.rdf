	<skos:prefLabel xml:lang="fr">Droit</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Derecho</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Право</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">قانون</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept547"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept548"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept549"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1413"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept12523"/>
