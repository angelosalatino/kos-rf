	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:34:14Z</dct:modified>
	<skos:altLabel xml:lang="ar">كثافة رأسمالية</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8761"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Capital intensity</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Intensité du capital</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Intensidad del capital</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Капиталоемкость</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">كثافة رأس المال</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept4628"/>
	<skos:scopeNote xml:lang="en">Relatively greater plant and equipment costs than labour costs.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Coût relativement plus important d'installation et d'équipement que de main-d'oeuvre.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Costes relativamente más elevados de instalación y de equipamiento que de mano de obra.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Относительно бóльшая стоимость производства и оборудования по сравнению со стоимостью труда.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">ارتفاع تكاليف المنشآت والمعدات بالنسبة إلى تكاليف العمالة.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept4628">
