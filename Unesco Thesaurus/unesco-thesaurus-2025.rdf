	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6944"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1274"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept4536"/>
	<skos:scopeNote xml:lang="en">The application of psychology to the work environment and personnel management.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Application de la psychologie à l'environnement de travail et à la gestion du personnel.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Aplicación de la psicología al entorno de trabajo y a la gestión del personal.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Использование методов психологии в рабочей обстановке и для управления персоналом.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">استخدام أساليب علم النفس في بيئة العمل ولإدارة شئون العاملين.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept7237">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:32:42Z</dct:modified>
