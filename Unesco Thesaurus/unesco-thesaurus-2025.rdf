	<skos:altLabel xml:lang="ar">نظم بيئية</skos:altLabel>
	<skos:altLabel xml:lang="ar">سلاسل غذائية</skos:altLabel>
	<skos:altLabel xml:lang="ar">مجتمعات بيولوجية</skos:altLabel>
