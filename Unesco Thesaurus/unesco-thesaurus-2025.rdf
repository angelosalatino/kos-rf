<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept2596">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:28:54Z</dct:modified>
	<skos:altLabel xml:lang="en">Alternative technology</skos:altLabel>
	<skos:altLabel xml:lang="en">Intermediate technology</skos:altLabel>
	<skos:altLabel xml:lang="fr">Technologie alternative</skos:altLabel>
	<skos:altLabel xml:lang="fr">Technologie intermédiaire</skos:altLabel>
	<skos:altLabel xml:lang="es">Tecnología alternativa</skos:altLabel>
	<skos:altLabel xml:lang="es">Tecnología apropiada</skos:altLabel>
	<skos:altLabel xml:lang="es">Tecnología intermediaria</skos:altLabel>
	<skos:altLabel xml:lang="ru">Альтернативная технология</skos:altLabel>
	<skos:altLabel xml:lang="ru">Промежуточная технология</skos:altLabel>
	<skos:altLabel xml:lang="ar">تكنولوجيا بديلة</skos:altLabel>
	<skos:altLabel xml:lang="ar">تكنولوجيا وسيطة</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5128"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Appropriate technology</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Technologie appropriée</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Tecnología adecuada</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Приемлемая технология</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تكنولوجيا ملائمة</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2601"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2599"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2600"/>
	<skos:scopeNote xml:lang="en">Technology adapted to the needs, production system, and natural resources of a given country.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Technologie adaptée aux besoins, au système de production et aux ressources naturelles d'un pays donné.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Tecnología adaptada a las necesidades, al sistema de producción y a los recursos naturales de un país determinado.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Технология, адаптированная к потребностям, производственной системе и природным ресурсам конкретной страны.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">التكنولوجيا التي تتلائم مع احتياجات ونظام الإنتاج والموارد الطبيعية لبلد ما.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept2599">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:34:10Z</dct:modified>
	<skos:altLabel xml:lang="ar">تطوير محلي</skos:altLabel>
	<skos:altLabel xml:lang="ar">تنمية ذاتية</skos:altLabel>
	<skos:altLabel xml:lang="ar">تطوير ذاتي</skos:altLabel>
	<skos:altLabel xml:lang="ar">تنمية ذاتية محلية</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7876"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Endogenous development</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Développement endogène</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Desarrollo endógeno</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Эндогенное развитие</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تنمية محلية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept260"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2601"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2596"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6964"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3440"/>
	<skos:scopeNote xml:lang="en">Based on the socio-cultural characteristics of a country, rather than on its integration into the world economy.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Basé sur les caractères socioculturels propres à un pays plutôt que sur son intégration à l'économie mondiale.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Basado en las características socioculturales de un país más que en su integración en la economía mundial.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Ориентировано на учет социально-культурных особенностей страны, а не на проблемы интеграции этой страны в мировую экономику.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">استنادا إلى يمتلكه بلد ما من خصائص اجتماعية وثقافية، لا إلى اندماجه في الاقتصاد العالمي.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept260">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T14:36:27Z</dct:modified>
	<skos:altLabel xml:lang="en">Cultural alienation</skos:altLabel>
	<skos:altLabel xml:lang="en">Cultural identification</skos:altLabel>
	<skos:altLabel xml:lang="en">Ethnic identity</skos:altLabel>
	<skos:altLabel xml:lang="fr">Aliénation culturelle</skos:altLabel>
	<skos:altLabel xml:lang="fr">Identification culturelle</skos:altLabel>
	<skos:altLabel xml:lang="fr">Identité ethnique</skos:altLabel>
	<skos:altLabel xml:lang="es">Alienación cultural</skos:altLabel>
	<skos:altLabel xml:lang="es">Identidad étnica</skos:altLabel>
	<skos:altLabel xml:lang="es">Identificación cultural</skos:altLabel>
	<skos:altLabel xml:lang="ru">Культурное отчуждение</skos:altLabel>
	<skos:altLabel xml:lang="ru">Культурное определение</skos:altLabel>
	<skos:altLabel xml:lang="ru">Этническая идентичность</skos:altLabel>
	<skos:altLabel xml:lang="ar">تغريب ثقافي</skos:altLabel>
	<skos:altLabel xml:lang="ar">هوية إثنية</skos:altLabel>
	<skos:altLabel xml:lang="ar">ابراز الهوية الثقافية</skos:altLabel>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1194"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7040"/>
	<skos:prefLabel xml:lang="en">Cultural identity</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Identité culturelle</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Identidad cultural</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Культурная идентичность</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">هوية ثقافية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept264"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17090"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept556"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2599"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7021"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6989"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept7078"/>
	<skos:scopeNote xml:lang="en">Denotes the correspondence which exists between a community (national, ethnic, linguistic, etc.) and its cultural life, as well as the right of each community to its own culture.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Désigne la correspondance qui existe entre une communauté (nationale, ethnique, linguistique, etc.) et sa vie culturelle, aussi bien que le droit de chaque communauté au maintien de sa propre culture.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Correspondencia que existe entre una comunidad (nacional, étnica, lingüística, etc.) y su vida cultural, así como el derecho de cada comunidad a mantener su propia cultura.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Указывает на связь, существующую между сообществом (национальным, этническим, языковым и т.д.) и его культурной жизнью, а также на право каждого сообщества иметь свою собственную культурную жизнь.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">يشير إلى الرابط الموجود بين المجتمع (القومي والعرقي واللغوي وغير ذلك) وبين الحياة الثقافية، بالإضافة إلى حق كل مجتمع في أن يكون له حياة ثقافية خاصة به.</skos:scopeNote>
	<skos:topConceptOf rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept2600">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:35:43Z</dct:modified>
	<skos:altLabel xml:lang="en">Horizontal technology transfer</skos:altLabel>
	<skos:altLabel xml:lang="en">Transfer of techniques</skos:altLabel>
	<skos:altLabel xml:lang="en">Vertical technology transfer</skos:altLabel>
	<skos:altLabel xml:lang="fr">Transfert de technique</skos:altLabel>
	<skos:altLabel xml:lang="fr">Transfert horizontal de technologie</skos:altLabel>
	<skos:altLabel xml:lang="fr">Transfert vertical de technologie</skos:altLabel>
	<skos:altLabel xml:lang="es">Intercambio tecnológico</skos:altLabel>
	<skos:altLabel xml:lang="es">Transferencia de técnicas</skos:altLabel>
	<skos:altLabel xml:lang="es">Transferencia horizontal de tecnología</skos:altLabel>
	<skos:altLabel xml:lang="es">Transferencia vertical de tecnología</skos:altLabel>
	<skos:altLabel xml:lang="ru">Горизонтальный трансфер технологий</skos:altLabel>
	<skos:altLabel xml:lang="ru">Трансфер технических навыков</skos:altLabel>
	<skos:altLabel xml:lang="ru">Вертикальный трансфер технологий</skos:altLabel>
	<skos:altLabel xml:lang="ar">نقل رأسي للتكنولوجيا</skos:altLabel>
	<skos:altLabel xml:lang="ar">نقل التقنيات</skos:altLabel>
	<skos:altLabel xml:lang="ar">نقل افقي للتكنولوجيا</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept116"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8013"/>
	<skos:prefLabel xml:lang="en">Technology transfer</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Transfert de technologie</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Transferencia de tecnología</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Трансфер технологий</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">نقل التكنولوجيا</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1151"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2596"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept5128"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept4566"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6585"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept8214"/>
	<skos:scopeNote xml:lang="en">Access to new technology, both products and production techniques, as a key factor in the economic growth of developing countries.</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Accès aux nouvelles technologies, tant aux produits qu'aux techniques de production, en tant que facteur clé de la croissance économique des pays en développement.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Acceso a las nuevas tecnologías, tanto a los productos como a las técnicas de producción, como factor clave del crecimiento económico en los países en desarrollo.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Доступ к новой технологии в виде готовой продукции и производственных процессов в качестве ключевого фактора экономического роста развивающихся стран.</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">إمكانية الوصول إلى التكنولوجيا الجديدة من منتجات وتقنيات الإنتاج، كعامل رئيسي في النمو الاقتصادي للدول النامية.</skos:scopeNote>
</skos:Concept>
<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept2601">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-22T15:25:42Z</dct:modified>
	<skos:altLabel xml:lang="en">Endogenous technology</skos:altLabel>
	<skos:altLabel xml:lang="ru">Эндогенная технология</skos:altLabel>
	<skos:altLabel xml:lang="ar">تكنولوجيا محلية</skos:altLabel>
	<skos:broader rdf:resource="http://vocabularies.unesco.org/thesaurus/concept116"/>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:prefLabel xml:lang="en">Traditional technology</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Technologie traditionnelle</skos:prefLabel>
	<skos:prefLabel xml:lang="es">Tecnología tradicional</skos:prefLabel>
	<skos:prefLabel xml:lang="ru">Традиционная технология</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تكنولوجيا تقليدية</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept17023"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2596"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2599"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept3592"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6801"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6992"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept6291"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept9673"/>
	<skos:scopeNote xml:lang="en">Techniques passed from generation to generation (although some modernized components or processes may be included).</skos:scopeNote>
	<skos:scopeNote xml:lang="fr">Technique transmise de génération en génération, bien que certaines composantes ou certains processus modernes aient pu être intégrés.</skos:scopeNote>
	<skos:scopeNote xml:lang="es">Técnica transmitida de generación en generación aunque se hayan incorporado algunos componentes o procedimientos modernos.</skos:scopeNote>
	<skos:scopeNote xml:lang="ru">Технологии, передаваемые из поколения в поколение (с возможной модернизацией отдельных элементов или процессов).</skos:scopeNote>
	<skos:scopeNote xml:lang="ar">تقنيات تناقلت من جيل إلى آخر (رغم أنها قد تشتمل على بعض المكونات أو العمليات الحديثة).</skos:scopeNote>
</skos:Concept>
