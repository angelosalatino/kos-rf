	<skos:prefLabel xml:lang="ru">Профессиональная подготовка</skos:prefLabel>
	<skos:prefLabel xml:lang="ar">تدريب مهني</skos:prefLabel>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1497"/>
	<skos:related rdf:resource="http://vocabularies.unesco.org/thesaurus/concept1755"/>
