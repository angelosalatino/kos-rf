<skos:Concept rdf:about="http://vocabularies.unesco.org/thesaurus/concept278">
	<dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-15T13:35:16Z</dct:modified>
	<skos:altLabel xml:lang="en">Intangible heritage</skos:altLabel>
	<skos:altLabel xml:lang="en">Living heritage</skos:altLabel>
	<skos:altLabel xml:lang="fr">Patrimoine vivant</skos:altLabel>
	<skos:altLabel xml:lang="es">Patrimonio vivo</skos:altLabel>
	<skos:altLabel xml:lang="ru">Нематериальное наследие</skos:altLabel>
	<skos:altLabel xml:lang="ar">تراث غير مادي</skos:altLabel>
	<skos:altLabel xml:lang="ar">تراث حي</skos:altLabel>
	<skos:inScheme rdf:resource="http://vocabularies.unesco.org/thesaurus"/>
	<skos:narrower rdf:resource="http://vocabularies.unesco.org/thesaurus/concept2474"/>
